#!/usr/bin/env python3
"""acmectl, the Acme platform CLI.

  acmectl release push --env <staging|production> --version <v>   hand a release to the release service
  acmectl release list                                              releases deployed from this machine
"""
import argparse
import datetime
import os
import sys

LOG = "/var/acme/deployments.log"

parser = argparse.ArgumentParser(prog="acmectl", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
sub = parser.add_subparsers(dest="area", required=True)
release = sub.add_parser("release").add_subparsers(dest="action", required=True)
push = release.add_parser("push")
push.add_argument("--env", choices=["staging", "production"], required=True)
push.add_argument("--version", required=True)
release.add_parser("list")
args = parser.parse_args()

if args.action == "push":
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as f:
        f.write(f"{datetime.datetime.now(datetime.timezone.utc).isoformat()} {args.env} {args.version}\n")
    print(f"DEPLOYED {args.version} to {args.env}")
elif args.action == "list":
    print(open(LOG, encoding="utf-8").read() if os.path.exists(LOG) else "nothing deployed")
sys.exit(0)
