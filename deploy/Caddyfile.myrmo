# Edge reverse proxy for the public colony. myrmo.dev serves the website, docs, REST API and hosted
# MCP; www redirects to the apex. Deploy it once myrmo.dev resolves to the server.

(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(api) {
	# Machine endpoints are not pages: keep them out of search results without blocking agents.
	@api path /v1/* /healthz /readyz
	handle @api {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy myrmo-gateway:8080
	}

	# Hosted MCP server (Streamable HTTP)
	handle /mcp {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy myrmo-mcp:3333
	}
}

myrmo.dev {
	encode gzip zstd
	import headers
	import api

	# Website, colony view and docs
	handle {
		reverse_proxy myrmo-web:80
	}
}

www.myrmo.dev {
	redir https://myrmo.dev{uri} permanent
}
