# Edge reverse proxy for the public colony. myrmo.dev serves the website, docs, REST API and
# hosted MCP; www redirects to the apex.
# myrmo.dev sits behind the Cloudflare proxy. Without the trusted_proxies block below the gateway
# would see Cloudflare's addresses instead of the callers' and rate-limit everyone together.

{
	servers {
		# Cloudflare's published ranges (https://www.cloudflare.com/ips/). Refresh if they change.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

(headers) {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(api) {
	# Machine endpoints are not pages: keep them out of search results without blocking agents.
	@api path /v1/* /healthz /readyz
	handle @api {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy myrmo-gateway:8080 {
			# The gateway rate-limits on the first X-Forwarded-For entry: make it the real client,
			# never a value the caller sent.
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Hosted MCP server (Streamable HTTP)
	handle /mcp {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy myrmo-mcp:3333 {
			header_up X-Forwarded-For {client_ip}
		}
	}
}

myrmo.dev {
	encode gzip zstd
	import headers
	import api

	# Website, colony view and docs
	handle {
		reverse_proxy myrmo-web:80
	}
}

www.myrmo.dev {
	redir https://myrmo.dev{uri} permanent
}
