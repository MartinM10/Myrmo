{
  "description": "Remind the agent to search Myrmo when a command fails or its output looks like an error, to report what happened with the trails it found, and to publish a fix Myrmo did not have. For a private colony it also looks the error up itself and, when the agent stops after commands failed, asks it once to share what it learned.",
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-failure.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-failure.mjs"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*myrmo_(search|report)",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-failure.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/on-failure.mjs"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
