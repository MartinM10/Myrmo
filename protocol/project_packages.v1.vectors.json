{
  "description": "What a project's own files say about its packages and runtime, read for a search or a published fix. Only names and versions of direct dependencies leave a project: a version spec that points at a place (path, repository, workspace, URL) is not a package, a lock file gives the installed release, and a lower bound (>=) is not a release. The packages a text names come first (as whole words), at most 30 unless `max` says otherwise. Scoped npm names (@scope/name) are read only when `scoped` is true. The runtime is node or python when the project has only that kind of manifest, with the release only from .nvmrc, .node-version or .python-version when it has a minor. The Claude Code plugin's hook, the TypeScript SDK and the Python SDK must reproduce this file exactly.",
  "packages": [
    {
      "why": "a Node project: direct dependencies, the locked release when there is one, the range when not",
      "files": {
        "package.json": {
          "name": "app",
          "dependencies": {
            "react": "^18.2.0",
            "lodash": "~4.17.0"
          },
          "devDependencies": {
            "vitest": "^1.0.0"
          }
        },
        "package-lock.json": {
          "lockfileVersion": 3,
          "packages": {
            "": {},
            "node_modules/react": {
              "version": "18.3.1"
            },
            "node_modules/react-dom": {
              "version": "18.3.1"
            }
          }
        }
      },
      "options": {},
      "expected": [
        {
          "name": "react",
          "version": "18.3.1"
        },
        {
          "name": "lodash",
          "version": "~4.17.0"
        },
        {
          "name": "vitest",
          "version": "^1.0.0"
        }
      ]
    },
    {
      "why": "what points at a place, a workspace sibling or the project itself is not a package",
      "files": {
        "package.json": {
          "name": "app",
          "dependencies": {
            "app": "1.0.0",
            "shared": "workspace:*",
            "local": "file:../local",
            "fork": "github:someone/fork",
            "tarball": "https://example.org/x.tgz",
            "real": "2.1.0"
          }
        }
      },
      "options": {},
      "expected": [
        {
          "name": "real",
          "version": "2.1.0"
        }
      ]
    },
    {
      "why": "scoped npm names stay out unless the colony is the organisation's own",
      "files": {
        "package.json": {
          "dependencies": {
            "@acme/billing": "1.2.0",
            "react": "18.2.0"
          }
        }
      },
      "options": {},
      "expected": [
        {
          "name": "react",
          "version": "18.2.0"
        }
      ]
    },
    {
      "why": "scoped npm names go to an organisation's own colony",
      "files": {
        "package.json": {
          "dependencies": {
            "@acme/billing": "1.2.0",
            "react": "18.2.0"
          }
        }
      },
      "options": {
        "scoped": true
      },
      "expected": [
        {
          "name": "@acme/billing",
          "version": "1.2.0"
        },
        {
          "name": "react",
          "version": "18.2.0"
        }
      ]
    },
    {
      "why": "a Python project: requirements pins, pyproject dependencies, the release a lock file pins; a lower bound is no release; paths and includes are not packages",
      "files": {
        "requirements.txt": "numpy==1.24.4\nrequests[socks]~=2.31\n# comment\n-r other.txt\n-e ./local\npandas>=2.0  # a floor says nothing about the release\n./wheel.whl\n",
        "pyproject.toml": "[project]\nname = \"app\"\ndependencies = [\n  \"flask>=3.0\",\n  \"httpx==0.27.0\",\n]\n\n[tool.poetry.dependencies]\npython = \"^3.11\"\nsqlalchemy = \"^2.0\"\ndjango = { version = \"^5.0\", extras = [\"argon2\"] }\n",
        "poetry.lock": "[[package]]\nname = \"Flask\"\nversion = \"3.0.3\"\n\n[[package]]\nname = \"numpy\"\nversion = \"1.26.0\"\n"
      },
      "options": {},
      "expected": [
        {
          "name": "numpy",
          "version": "1.26.0"
        },
        {
          "name": "requests",
          "version": "2.31"
        },
        {
          "name": "pandas"
        },
        {
          "name": "flask",
          "version": "3.0.3"
        },
        {
          "name": "httpx",
          "version": "0.27.0"
        },
        {
          "name": "sqlalchemy",
          "version": "^2.0"
        },
        {
          "name": "django",
          "version": "^5.0"
        }
      ]
    },
