  "runtime": [
    {
      "why": "a Node project is node",
      "files": {
        "package.json": {}
      },
      "expected": {
        "name": "node"
      }
    },
    {
      "why": "a release only from a version file with a minor",
      "files": {
        "package.json": {},
        ".nvmrc": "v20.11.0\n"
      },
      "expected": {
        "name": "node",
        "version": "20.11.0"
      }
    },
    {
      "why": "a bare major is no release",
      "files": {
        "package.json": {},
        ".nvmrc": "20\n"
      },
      "expected": {
        "name": "node"
      }
    },
    {
      "why": "a Python project is python, with the release from .python-version",
      "files": {
        "pyproject.toml": "[project]\nname='x'\n",
        ".python-version": "3.12\n"
      },
      "expected": {
        "name": "python",
        "version": "3.12"
      }
    },
    {
      "why": "a project with both says nothing",
      "files": {
        "package.json": {},
        "requirements.txt": "numpy\n"
      },
      "expected": null
    },
    {
      "why": "a project with neither says nothing",
