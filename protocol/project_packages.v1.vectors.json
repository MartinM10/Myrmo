    {
      "why": "onlyNamed keeps the packages the text names and nothing else",
      "files": {
        "package.json": {
          "dependencies": {
            "react": "^18.2.0",
            "lodash": "4.17.21",
            "vue": "3.4.0"
          }
        }
      },
      "options": {
